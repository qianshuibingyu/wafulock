# Extensionless canonical URLs
# The site links internally without ".html" (for example /products), while
# the deployed files are static HTML files (for example products.html).
# _redirects is not read by the ECS web server, so handle the mapping here.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Retire resource URLs with direct permanent redirects before extensionless mapping.
  RewriteRule ^resource/technology-(eleven|twenty|seven)(\.html)?$ /resource/smart-lock-factory-audit-guide [R=301,L,NE]
  RewriteRule ^resource/technology-thirteen(\.html)?$ /resource/invisible-lock-odm-development-guide [R=301,L,NE]
  RewriteRule ^resource/technology-four(\.html)?$ /resource/invisible-lock-engineering-selection [R=301,L,NE]
  RewriteRule ^resource/technology-eight(\.html)?$ /resource/technology-nine [R=301,L,NE]
  RewriteRule ^resource/technology-ten(\.html)?$ /resource/smart-invisible-lock-solutions [R=301,L,NE]
  RewriteRule ^resource/technology-fourteen(\.html)?$ /resource/invisible-smart-lock-rfq-preparation [R=301,L,NE]
  RewriteRule ^resource/technology-twentyone(\.html)?$ /resource/wf-010-wf-019-wf-026-invisible-smart-lock-distributor-portfolio [R=301,L,NE]
  RewriteRule ^resource/invisible-lock-compatibility-guide(\.html)?$ /resource/invisible-lock-compatibility-issues [R=301,L,NE]
  RewriteRule ^resource/invisible-lock-(ODM|odm)(\.html)?$ /resource/invisible-lock-odm-development-guide [R=301,L,NE]
  RewriteRule ^resource/bulk-invisible-lock(\.html)?$ /resource/invisible-smart-lock-rfq-preparation [R=301,L,NE]
  RewriteRule ^resource/invisible-lock-line(\.html)?$ /resource/wf-010-wf-019-wf-026-invisible-smart-lock-distributor-portfolio [R=301,L,NE]
  RewriteRule ^resource/invisible-lock-guide(\.html)?$ /resource/smart-lock-factory-audit-guide [R=301,L,NE]

  # Search-engine discovery files must be served directly as public text/XML.
  RewriteRule ^robots\.txt$ - [END]
  RewriteRule ^sitemap\.xml$ - [END]

  # Keep real files and directories untouched (including sitemap.xml and robots.txt).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ $1.html [END]
</IfModule>

<FilesMatch "^(robots\.txt|sitemap\.xml)$">
  Require all granted
</FilesMatch>

<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

# Static asset caching for Lighthouse / production performance
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Serve custom 404 page for missing URLs at any depth
ErrorDocument 404 /404.html
