<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
    <httpCompression>
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
      </staticTypes>
    </httpCompression>
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="Retire technology eleven twenty seven" stopProcessing="true">
          <match url="^resource/technology-(eleven|twenty|seven)(\.html)?$" />
          <action type="Redirect" url="/resource/smart-lock-factory-audit-guide" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology thirteen" stopProcessing="true">
          <match url="^resource/technology-thirteen(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-lock-odm-development-guide" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology four" stopProcessing="true">
          <match url="^resource/technology-four(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-lock-engineering-selection" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology eight" stopProcessing="true">
          <match url="^resource/technology-eight(\.html)?$" />
          <action type="Redirect" url="/resource/technology-nine" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology ten" stopProcessing="true">
          <match url="^resource/technology-ten(\.html)?$" />
          <action type="Redirect" url="/resource/smart-invisible-lock-solutions" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology fourteen" stopProcessing="true">
          <match url="^resource/technology-fourteen(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-smart-lock-rfq-preparation" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire technology twentyone" stopProcessing="true">
          <match url="^resource/technology-twentyone(\.html)?$" />
          <action type="Redirect" url="/resource/wf-010-wf-019-wf-026-invisible-smart-lock-distributor-portfolio" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire compatibility guide" stopProcessing="true">
          <match url="^resource/invisible-lock-compatibility-guide(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-lock-compatibility-issues" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire ODM alias" stopProcessing="true">
          <match url="^resource/invisible-lock-(ODM|odm)(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-lock-odm-development-guide" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire bulk lock alias" stopProcessing="true">
          <match url="^resource/bulk-invisible-lock(\.html)?$" />
          <action type="Redirect" url="/resource/invisible-smart-lock-rfq-preparation" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire lock line alias" stopProcessing="true">
          <match url="^resource/invisible-lock-line(\.html)?$" />
          <action type="Redirect" url="/resource/wf-010-wf-019-wf-026-invisible-smart-lock-distributor-portfolio" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Retire lock guide alias" stopProcessing="true">
          <match url="^resource/invisible-lock-guide(\.html)?$" />
          <action type="Redirect" url="/resource/smart-lock-factory-audit-guide" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Cache static assets">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="\.(webp|png|jpe?g|gif|svg|ico|css|js|woff2)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Cache HTML">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="\.html?$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=0, must-revalidate" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
